# Backend environment template
# Use this file for:
# 1. local backend runs with `cd backend && npm run dev`
# 2. Docker backend runs via `docker compose`, since the backend service loads `backend/.env`

PORT=5000
MONGODB_URI=mongodb://localhost:27017/formos
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
MFA_ENCRYPTION_KEY=replace_with_a_long_random_secret
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
OAUTH_STATE_SECRET=replace_with_a_long_random_oauth_state_secret
OAUTH_FLOW_TTL_MINUTES=10
STEP_UP_TTL_MINUTES=10
TRUSTED_DEVICE_DAYS=30
SESSION_TTL_DAYS=30
PENDING_REGISTRATION_TTL_MINUTES=15
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=security@your-domain.com

# Brevo SMTP (used by Nodemailer - primary email provider)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASS=your_brevo_smtp_password
# If Nodemailer/Brevo fails, OTP is automatically logged to console (dev fallback)

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# AI Configuration
# Primary = OpenRouter, Fallback = CleanAPI (used automatically when OpenRouter fails or is rate limited)
AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# CleanAPI fallback — used automatically if OpenRouter fails
# CLEANAPI_API_KEY=your_cleanapi_api_key_here
# CLEANAPI_BASE_URL=https://cleanapis.com/v1
# CLEANAPI_MODEL=gemini-3.7-flash
# Alternative providers
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=cleanapi
# (CleanAPI as primary and OpenRouter as the fallback: the reverse order)

# AWS S3 Configuration (Optional - if not set, files will be stored locally)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Admin console sign-in: "true" also asks for the authenticator code after the password.
# Unset or "false" means the admin password alone signs staff in.
ADMIN_REQUIRE_MFA=false

# WhatsApp assistant (whatsapp-web.js). The admin console links the sending account with a QR code.
# WHATSAPP_ENABLED=false switches it off. The saved login is stored in MongoDB and restored on every start, so no
# persistent disk is needed and a redeploy does not ask for a new QR scan. Nothing is kept on disk between runs: the
# browser profile is a temporary folder (the system temp directory unless WHATSAPP_SESSION_DIR is set).
WHATSAPP_ENABLED=true
# WHATSAPP_SESSION_DIR=
# WHATSAPP_CLIENT_ID=formos   (the login's name in MongoDB. Use a different one for each environment that shares a
#                              database, e.g. dev and production, or they will fight over the same WhatsApp login.)
# WHATSAPP_AUTOSTART=false
# WHATSAPP_NO_SANDBOX=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# WHATSAPP_WEB_VERSION_URL=   (pin a known-good WhatsApp Web page if WhatsApp changes it and file downloads or sending break)
# WHATSAPP_UNLOCK_MINUTES=0   (0 = full details stay unlocked until the member sends lock)

# File storage. Cloudflare R2 is used when all four R2 settings are filled in; otherwise AWS S3 (above),
# otherwise this server's disk. Create an R2 bucket and an API token with "Object Read & Write" for it
# in the Cloudflare dashboard. Put the values in backend/.env only, never in code or chat.
# After saving, run: node scripts/check-storage.js
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com   (only if you need a custom address, for example the EU jurisdiction)
